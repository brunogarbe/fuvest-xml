		<xs:attribute name="subject" type="Classification"/>
	</xs:complexType>
	
	<!-- Align attribute -->
	<xs:attributeGroup name="AlignAttribute">
		<xs:attribute name="align" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="center"/>
					<xs:enumeration value="right"/>
					<xs:enumeration value="left"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:attributeGroup>
	
	<!-- Percentage restriction -->
	<xs:simpleType name="Percentage">
		<xs:restriction base="xs:decimal">
			<xs:minInclusive value="0"/>
			<xs:maxInclusive value="100"/>
			<xs:fractionDigits value="1"/>
			<!-- Optional: for precision -->
		</xs:restriction>
	</xs:simpleType>
	
	
	<!-- ===================== Inline Elements ===================== -->
	
	<!-- style -->
	<xs:complexType name="StyleType" mixed="true">
		<xs:attribute name="color" type="xs:string" use="required"/>
	</xs:complexType>
	<xs:element name="style" type="StyleType"/>
	
	<!-- Inline math -->
	<xs:simpleType name="TextOnlyType">
		<xs:restriction base="xs:string"/>
	</xs:simpleType>
	<xs:element name="m" type="TextOnlyType"/>
	<xs:element name="c" type="TextOnlyType"/>
	
	<!-- Display math -->
	<xs:complexType name="DisplayMathType">
		<xs:simpleContent>
			<xs:extension base="xs:string">
				<xs:attribute name="end" type="xs:string" use="optional"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:element name="math" type="DisplayMathType"/>
	<xs:element name="chem" type="DisplayMathType"/>
	
	<!-- ref -->
	<xs:complexType name="OnlyAttributeType">
		<xs:attribute name="id" type="xs:string" use="required"/>
	</xs:complexType>
	<xs:element name="ref" type="OnlyAttributeType"/>
	
	<!-- Inline Nested Elements -->
	<xs:complexType name="InlineType" mixed="true">
		<xs:sequence minOccurs="0" maxOccurs="unbounded">
			<!-- Allow nested inline content inside <b> if desired -->
			<xs:choice>
				<xs:element ref="b"/>
				<xs:element ref="i"/>
				<xs:element ref="u"/>
				<xs:element ref="q"/>
				<xs:element ref="style"/>
				<xs:element ref="m"/>
				<xs:element ref="math"/>
				<xs:element ref="c"/>
				<xs:element ref="chem"/>
				<xs:element ref="ref"/>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="b" type="InlineType"/>
	<xs:element name="i" type="InlineType"/>
	<xs:element name="u" type="InlineType"/>
	<xs:element name="q" type="InlineType"/>

	
	
	<!-- ===================== Image ===================== -->
	
	<!-- Image -->
	<xs:complexType name="ImageType">
		<xs:attribute name="src" type="xs:string" use="required"/>
		<xs:attribute name="size" type="xs:string"/>
		<xs:attribute name="width" type="xs:string"/>
		<xs:attribute name="html_width" type="xs:string"/>
		<xs:attribute name="wrap" type="xs:boolean"/>
	</xs:complexType>
	<xs:element name="image" type="ImageType"/>
	
	
	<!-- ===================== Paragraph with Mixed Content ===================== -->
	
	<xs:complexType name="ParagraphType" mixed="true">
		<xs:sequence minOccurs="0" maxOccurs="unbounded">
			<xs:choice>
				<xs:element ref="b"/>
				<xs:element ref="i"/>
				<xs:element ref="u"/>
				<xs:element ref="q"/>
				<xs:element ref="style"/>
				<xs:element ref="m"/>
				<xs:element ref="math"/>
				<xs:element ref="c"/>
				<xs:element ref="chem"/>
				<xs:element ref="ref"/>
			</xs:choice>
		</xs:sequence>
		<!-- Example optional attributes for paragraph styling/ids -->
		<xs:attributeGroup  ref="AlignAttribute" />
	</xs:complexType>
	<xs:element name="p" type="ParagraphType"/>
	<xs:element name="l" type="ParagraphType"/>
	<xs:element name="cite" type="ParagraphType"/>
	<xs:element name="header" type="ParagraphType"/>
	<xs:element name="caption" type="ParagraphType"/>

	<!-- Footnote -->
	<xs:complexType name="FootnoteType" mixed="true">
		<xs:sequence minOccurs="0" maxOccurs="unbounded">
			<xs:choice>
				<xs:element ref="b"/>
				<xs:element ref="i"/>
				<xs:element ref="u"/>
				<xs:element ref="q"/>
				<xs:element ref="m"/>
				<xs:element ref="math"/>
				<xs:element ref="c"/>
				<xs:element ref="chem"/>
				<xs:element ref="ref"/>
			</xs:choice>
		</xs:sequence>
		
		<!-- Example optional attributes for paragraph styling/ids -->
		<xs:attribute name="id" type="xs:string" use="required"/>
	</xs:complexType>
	<xs:element name="footnote" type="FootnoteType"/>


	<!-- ===================== Complex types ===================== -->
	
	<!-- Quote -->
	<xs:complexType name="ComplexDisplayType">
		<xs:sequence>
			<xs:element name="title" type="ParagraphType" minOccurs="0" maxOccurs="1"/>
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element ref="p"/>
				<xs:element ref="image"/>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="quote" type="ComplexDisplayType"/>
	
	<xs:complexType name="VerseType">
		<xs:sequence>
			<xs:element name="title" type="ParagraphType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="stanza" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element ref="l" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:element name="verse" type="VerseType"/>
	
	
	<!-- ===================== Lists ===================== -->
	
	<!-- List -->
	<xs:complexType name="ListType">
		<xs:sequence>
			<xs:element name="item" maxOccurs="unbounded">
				<xs:complexType>
					<xs:choice minOccurs="0" maxOccurs="unbounded">
						<xs:element ref="p"/>
						<xs:element ref="image"/>
					</xs:choice>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="list" type="ListType"/>
	
	<xs:complexType name="OrderedListType">
		<xs:sequence>
			<xs:element name="item" maxOccurs="unbounded">
				<xs:complexType>
					<xs:choice minOccurs="0" maxOccurs="unbounded">
						<xs:element ref="p"/>
						<xs:element ref="image"/>
					</xs:choice>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		
		<!-- Attributes -->
		<xs:attribute name="type" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="alpha"/>
					<xs:enumeration value="arabic"/>
					<xs:enumeration value="roman"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>
	<xs:element name="ordered_list" type="OrderedListType"/>
	
	
	<!-- ===================== Tables ===================== -->
	
	<!-- Cell -->
	<xs:complexType name="CellType">
		<xs:choice minOccurs="0" maxOccurs="1">
			<xs:element ref="p"/>
			<xs:element ref="image"/>
		</xs:choice>
		<!-- Attributes -->
		<xs:attribute name="align">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="center"/>
					<xs:enumeration value="right"/>
					<xs:enumeration value="left"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>
	
	<!-- Cell Rows -->
	<xs:complexType name="CellRowType">
		<xs:sequence>
			<xs:element name="cell" type="CellType" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	
	<!-- Table -->
	<xs:complexType name="TableType">
		<xs:sequence>
			<!-- <xs:element name="caption" type="xs:string" minOccurs="0" maxOccurs="1" /> -->
			<xs:element name="header" minOccurs="0" maxOccurs="1" type="CellRowType"/>
			<xs:element name="row" maxOccurs="unbounded" type="CellRowType"/>
		</xs:sequence>
		<xs:attribute name="width" type="Percentage"/>
		<xs:attribute name="columns" type="xs:string"/>
	</xs:complexType>
	<xs:element name="table" type="TableType"/>
	
	
	<!-- ===================== Statement Childs ===================== -->
	
	<!-- Reusable definition for a statemend childs -->
	<xs:complexType name="StatementChilds">
		<xs:choice maxOccurs="unbounded">
			<xs:element ref="quote"/>
			<xs:element ref="verse"/>
			<xs:element ref="header"/>
			<xs:element ref="caption"/>
			<xs:element ref="cite"/>
			<xs:element ref="p"/>
			<xs:element ref="footnote"/>
			<xs:element ref="image"/>
			<xs:element ref="list"/>
			<xs:element ref="table"/>
		</xs:choice>
	</xs:complexType>
	
	
	<!-- ===================== Options ===================== -->
	
	<!-- Option -->
	<xs:complexType name="Option">
		<xs:choice minOccurs="1" maxOccurs="unbounded">
			<xs:element ref="p"/>
			<xs:element ref="image"/>
		</xs:choice>
		
		<!-- label atribute for option tag -->
		<xs:attribute name="label" type="xs:string" use="required"/>
		<!-- is_correct atribute for option tag -->
		<xs:attribute name="is_correct" type="xs:boolean" use="required"/>
	</xs:complexType>
	
	<!-- Options -->
	<xs:complexType name="Options">
		<xs:sequence>
			<xs:element name="option" maxOccurs="unbounded" type="Option"/>
		</xs:sequence>
	</xs:complexType>
	
	<xs:complexType name="OptionsTable">
		<xs:sequence>
			<xs:element name="header" minOccurs="0" maxOccurs="1" type="CellRowType"/>
			<xs:element name="option" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="cell" maxOccurs="unbounded" type="CellType"/>
					</xs:sequence>
					<!-- label atribute for option tag -->
					<xs:attribute name="label" type="xs:string" use="required"/>
					<!-- is_correct atribute for option tag -->
					<xs:attribute name="is_correct" type="xs:boolean" use="required"/>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	
	
	<!-- ===================== Parts ===================== -->
	
	<!-- Part -->
	<xs:complexType name="Part">
		<xs:choice minOccurs="0" maxOccurs="unbounded">
			<xs:element ref="p"/>
			<xs:element ref="image"/>
		</xs:choice>
	</xs:complexType>
	
	<!-- Parts -->
	<xs:complexType name="Parts">
		<xs:sequence>
			<xs:element name="part" maxOccurs="unbounded" type="Part"/>
		</xs:sequence>
	</xs:complexType>
	
	
	<!-- ===================== Question Group ===================== -->
	
	<!-- Reusable definition for a group of questions -->
	<xs:complexType name="QuestionGroup">
		<xs:sequence>
			<!-- Context tag for a group question -->
			<xs:element name="context" minOccurs="0" maxOccurs="1" type="StatementChilds"/>
			<xs:choice maxOccurs="unbounded">
				<!-- Objective Question tag -->
				<xs:element name="objective_question">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="classification" type="SubjectAttribute" maxOccurs="unbounded"/>
							<xs:element name="statement" type="StatementChilds"/>
							<xs:choice>
								<xs:element name="options" type="Options"/>
								<xs:element name="options_table" type="OptionsTable"/>
							</xs:choice>
							<xs:element name="assumptions" type="StatementChilds" minOccurs="0"/>
						</xs:sequence>
						<!-- Attributes -->
						<xs:attribute name="number" type="xs:integer" use="required"/>
						<xs:attribute name="null" type="xs:boolean"/>
						<xs:attribute name="success_rate" type="Percentage"/>
					</xs:complexType>
				</xs:element>
				<!-- Objective Question tag -->
				<xs:element name="discursive_question">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="classification" type="SubjectAttribute" maxOccurs="unbounded"/>
							<xs:element name="statement" type="StatementChilds"/>
							<xs:element name="parts" type="Parts"/>
							<xs:element name="assumptions" type="StatementChilds" minOccurs="0"/>
						</xs:sequence>
						<!-- Attributes -->
						<xs:attribute name="number" type="xs:integer" use="required"/>
						<xs:attribute name="null" type="xs:boolean"/>
						<xs:attribute name="success_rate" type="Percentage"/>
					</xs:complexType>
				</xs:element>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>
	
	
	<!-- ===================== Exam ===================== -->
	
	<!-- Definition for the root element 'exam' -->
	<xs:element name="exam">
		<xs:complexType>
			<xs:choice maxOccurs="unbounded">
				<xs:element name="question_group" type="QuestionGroup"/>
				<xs:element name="subject">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="question_group" type="QuestionGroup" maxOccurs="unbounded"/>
						</xs:sequence>
						<xs:attribute name="name" type="xs:string" use="required"/>
					</xs:complexType>
				</xs:element>
			</xs:choice>
			
			<!-- Attributes for the exam tag -->
			<xs:attribute name="name" type="xs:string" use="required"/>
			<xs:attribute name="year" type="xs:gYear" use="required"/>
			<xs:attribute name="phase" type="xs:string" use="required"/>
			<xs:attribute name="day" type="xs:integer" use="required"/>
			<xs:attribute name="variation" type="xs:string" use="required"/>
			<xs:attribute name="date" type="xs:date" use="required"/>
			<xs:attribute name="lang" type="xs:string" use="required"/>
		</xs:complexType>
	</xs:element>
</xs:schema>
